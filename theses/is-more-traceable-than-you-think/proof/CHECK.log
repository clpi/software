noPremises : Derivation Bool
onePremise : Derivation Bool
nodeOnly : Unit → Graph Bool
head_without_derivation : (fold nodeOnly [()]).nodes noPremises.head = true ∧
  (fold nodeOnly [()]).edges noPremises = false
head_only_claim_fails : ¬∀ (lift : Unit → Graph Bool) (l : List Unit) (d : Derivation Bool),
    (fold lift l).nodes d.head = true → (fold lift l).edges d = true
edgeOnly : Unit → Graph Bool
derivation_without_head : (fold edgeOnly [()]).edges noPremises = true ∧
  (fold edgeOnly [()]).nodes noPremises.head = false
edge_implies_head_claim_fails : ¬∀ (lift : Unit → Graph Bool) (l : List Unit) (d : Derivation Bool),
    (fold lift l).edges d = true → (fold lift l).nodes d.head = true
exactLift : Unit → Graph Bool
witnessed_head_does_not_select_premises : (fold exactLift [()]).nodes noPremises.head = true ∧
  onePremise.head = noPremises.head ∧
    (fold exactLift [()]).edges onePremise = true ∧ (fold exactLift [()]).edges noPremises = false
finiteDerivationEq : (a b : Derivation Bool) → Decidable (a = b)
record : Bool → Derivation Bool
same_head_distinct_recorded_premises : (fold (recordLift record) [false, true]).nodes noPremises.head = true ∧
  (fold (recordLift record) [false, true]).edges noPremises = true ∧
    (fold (recordLift record) [false, true]).edges onePremise = true ∧
      noPremises.head = onePremise.head ∧ noPremises ≠ onePremise
aliasedLift : Bool → Graph Bool
contributor_refuses_missing_edge : (fold nodeOnly [()]).nodes noPremises.head = true ∧
  contributor nodeOnly [()] noPremises = none
contributor_selection_is_order_sensitive : fold aliasedLift [false, true] = fold aliasedLift [true, false] ∧
  contributor aliasedLift [false, true] noPremises = some false ∧
    contributor aliasedLift [true, false] noPremises = some true
source_from_fold_claim_fails : ¬∃ decode, ∀ (e : Bool), decode (fold aliasedLift [e]) = e
time_from_fold_claim_fails : ¬∃ decode,
    ∀ (time : Nat), decode (foldtimed aliasedLift [{ event := false, time := time }]) = time
