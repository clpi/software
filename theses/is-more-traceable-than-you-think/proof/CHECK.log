Derivation : Type → Type
Graph : Type → Type
@join : {Node : Type} → Graph Node → Graph Node → Graph Node
@empty : {Node : Type} → Graph Node
@fold : {Node Ev : Type} → (Ev → Graph Node) → List Ev → Graph Node
Timed : Type → Type → Type
@foldtimed : {Node Ev Time : Type} → (Ev → Graph Node) → List (Timed Ev Time) → Graph Node
@bool_eq_of_agree : ∀ {a b : Bool}, (a = true ↔ b = true) → a = b
@graph_ext : ∀ {Node : Type} {g h : Graph Node},
  (∀ (n : Node), g.nodes n = h.nodes n) → (∀ (d : Derivation Node), g.edges d = h.edges d) → g = h
@join_assoc : ∀ {Node : Type} (a b c : Graph Node), join (join a b) c = join a (join b c)
@join_comm : ∀ {Node : Type} (a b : Graph Node), join a b = join b a
@join_idem : ∀ {Node : Type} (a : Graph Node), join a a = a
@join_empty_left : ∀ {Node : Type} (a : Graph Node), join empty a = a
@join_empty_right : ∀ {Node : Type} (a : Graph Node), join a empty = a
@fold_append : ∀ {Node Ev : Type} (lift : Ev → Graph Node) (l₁ l₂ : List Ev),
  fold lift (l₁ ++ l₂) = join (fold lift l₁) (fold lift l₂)
@fold_nodes : ∀ {Node Ev : Type} (lift : Ev → Graph Node) {l : List Ev} {n : Node},
  (fold lift l).nodes n = true ↔ ∃ e, e ∈ l ∧ (lift e).nodes n = true
@fold_edges : ∀ {Node Ev : Type} (lift : Ev → Graph Node) {l : List Ev} {d : Derivation Node},
  (fold lift l).edges d = true ↔ ∃ e, e ∈ l ∧ (lift e).edges d = true
@returns_head : ∀ {Node Ev : Type} (lift : Ev → Graph Node) {l : List Ev} {d : Derivation Node} (e : Ev),
  e ∈ l → (lift e).edges d = true → (fold lift l).edges d = true
@fold_ext : ∀ {Node Ev : Type} (lift : Ev → Graph Node) {l₁ l₂ : List Ev},
  (∀ (e : Ev), e ∈ l₁ ↔ e ∈ l₂) → fold lift l₁ = fold lift l₂
@fold_perm : ∀ {Node Ev : Type} (lift : Ev → Graph Node) {l₁ l₂ : List Ev}, l₁.Perm l₂ → fold lift l₁ = fold lift l₂
@fold_append_self : ∀ {Node Ev : Type} (lift : Ev → Graph Node) (l : List Ev), fold lift (l ++ l) = fold lift l
@foldtimed_ext : ∀ {Node Ev Time : Type} (lift : Ev → Graph Node) {l₁ l₂ : List (Timed Ev Time)},
  (∀ (e : Ev), e ∈ List.map Timed.event l₁ ↔ e ∈ List.map Timed.event l₂) → foldtimed lift l₁ = foldtimed lift l₂
@map_event : ∀ {Ev Time : Type} (es : List Ev) (t : Ev → Time),
  List.map Timed.event (List.map (fun e => { event := e, time := t e }) es) = es
@foldtimed_retime : ∀ {Node Ev Time : Type} (lift : Ev → Graph Node) (es : List Ev) (f g : Ev → Time),
  foldtimed lift (List.map (fun e => { event := e, time := f e }) es) =
    foldtimed lift (List.map (fun e => { event := e, time := g e }) es)
@retract_nodes : ∀ {Node Ev : Type} (lift : Ev → Graph Node) (keep : Ev → Bool) {l : List Ev} {n : Node},
  (fold lift (List.filter keep l)).nodes n = true ↔ ∃ e, e ∈ l ∧ keep e = true ∧ (lift e).nodes n = true
@retract_edges : ∀ {Node Ev : Type} (lift : Ev → Graph Node) (keep : Ev → Bool) {l : List Ev} {d : Derivation Node},
  (fold lift (List.filter keep l)).edges d = true ↔ ∃ e, e ∈ l ∧ keep e = true ∧ (lift e).edges d = true
@retract_eq : ∀ {Node Ev : Type} (lift : Ev → Graph Node) (keep : Ev → Bool) {l s : List Ev},
  (∀ (e : Ev), e ∈ s ↔ e ∈ l ∧ keep e = true) → fold lift (List.filter keep l) = fold lift s
