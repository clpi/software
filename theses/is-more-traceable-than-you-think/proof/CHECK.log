countjoin : (Nat → Nat) → (Nat → Nat) → Nat → Nat
countsingle : Nat → Nat → Nat
countfold : List Nat → Nat → Nat
count_once : countfold [0] 0 = 1
count_twice : countfold ([0] ++ [0]) 0 = 2
count_claim_fails : ¬∀ (l : List Nat), countfold (l ++ l) = countfold l
firstfold : (Nat → Graph Nat) → List Nat → Graph Nat
ownlift : Nat → Graph Nat
swap_same_set : ∀ (x : Nat), x ∈ [0, 1] ↔ x ∈ [1, 0]
first_claim_fails : ¬∀ (l₁ l₂ : List Nat), (∀ (x : Nat), x ∈ l₁ ↔ x ∈ l₂) → firstfold ownlift l₁ = firstfold ownlift l₂
fullprem : Derivation Nat
noprem : Derivation Nat
prem_differ : fullprem ≠ noprem
grainlift : Nat → Graph Nat
grain_absent : (fold grainlift [0]).edges noprem = false
grain_coarse_present : ∃ d', (fold grainlift [0]).edges d' = true ∧ d'.head = noprem.head
grain_claim_fails : ¬∀ (d : Derivation Nat),
    (∃ d', (fold grainlift [0]).edges d' = true ∧ d'.head = d.head) → (fold grainlift [0]).edges d = true
residuefold : (Nat → Graph Nat) → (Nat → Bool) → List Nat → Graph Nat
residue_survivor_absent : (fold ownlift (List.filter (fun e => decide (e = 1)) [0, 1])).nodes 0 = false
residue_present : (residuefold ownlift (fun e => decide (e = 1)) [0, 1]).nodes 0 = true
residue_claim_fails : residuefold ownlift (fun e => decide (e = 1)) [0, 1] ≠
  fold ownlift (List.filter (fun e => decide (e = 1)) [0, 1])
