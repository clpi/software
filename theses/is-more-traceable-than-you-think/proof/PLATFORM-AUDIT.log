ReturnControls.exactLift : Unit → Traceability.Graph Bool
ReturnControls.witnessed_head_does_not_select_premises : (Traceability.fold ReturnControls.exactLift [()]).nodes
      ReturnControls.noPremises.head =
    true ∧
  ReturnControls.onePremise.head = ReturnControls.noPremises.head ∧
    (Traceability.fold ReturnControls.exactLift [()]).edges ReturnControls.onePremise = true ∧
      (Traceability.fold ReturnControls.exactLift [()]).edges ReturnControls.noPremises = false
ReturnControls.finiteDerivationEq : (a b : Traceability.Derivation Bool) → Decidable (a = b)
ReturnControls.record : Bool → Traceability.Derivation Bool
