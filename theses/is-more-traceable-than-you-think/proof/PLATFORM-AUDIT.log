Controls.countfold : List Nat → Nat → Nat
Controls.count_once : Controls.countfold [0] 0 = 1
Controls.count_twice : Controls.countfold ([0] ++ [0]) 0 = 2
Controls.count_claim_fails : ¬∀ (l : List Nat), Controls.countfold (l ++ l) = Controls.countfold l
Controls.firstfold : (Nat → Traceability.Graph Nat) → List Nat → Traceability.Graph Nat
Controls.ownlift : Nat → Traceability.Graph Nat
Controls.swap_same_set : ∀ (x : Nat), x ∈ [0, 1] ↔ x ∈ [1, 0]
