  ↑event ∈ origins → event ∈ Provenance.witnesses tasks origins
Provenance.retained_return : ∀ (tasks : List Incremental.TaskKey) (origins : List Nat) (event : Provenance.Event tasks),
  event ∈ Provenance.witnesses tasks origins →
    (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks origins)).nodes
          (Provenance.head tasks event) =
        true ∧
      (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks origins)).edges
            (Provenance.record tasks event) =
          true ∧
        Traceability.contributor (Provenance.lift tasks) (Provenance.witnesses tasks origins)
            (Provenance.record tasks event) =
          some event
@Provenance.completed_return : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value)
  (tasks : List Incremental.TaskKey) {state next : Projection.State Value} {task : Nat},
  Projection.complete op tasks state task = some next →
    ∃ event,
      ↑event = task ∧
        event ∈ Provenance.witnesses tasks next.origins ∧
          (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)).nodes
                (Provenance.head tasks event) =
              true ∧
            (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)).edges
                  (Provenance.record tasks event) =
                true ∧
              Traceability.contributor (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)
                  (Provenance.record tasks event) =
                some event
@Provenance.publish_origins : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value)
  (tasks : List Incremental.TaskKey) {state next : Projection.State Value} {order : List Nat},
  Projection.publish op tasks state order = some next → next.origins = state.origins ++ order
@Provenance.published_tasks_exist : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value)
  (tasks : List Incremental.TaskKey) {state next : Projection.State Value} {order : List Nat},
  Projection.publish op tasks state order = some next → ∀ (task : Nat), task ∈ order → ∃ key, tasks[task]? = some key
@Provenance.published_return : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value)
  (tasks : List Incremental.TaskKey) {next : Projection.State Value} {order : List Nat},
  Projection.publish op tasks Projection.empty order = some next →
    ∀ {task : Nat},
      task ∈ order →
        ∃ event,
          ↑event = task ∧
            event ∈ Provenance.witnesses tasks next.origins ∧
              (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)).nodes
                    (Provenance.head tasks event) =
                  true ∧
                (Traceability.fold (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)).edges
                      (Provenance.record tasks event) =
                    true ∧
                  Traceability.contributor (Provenance.lift tasks) (Provenance.witnesses tasks next.origins)
                      (Provenance.record tasks event) =
                    some event
ReturnControls.noPremises : Traceability.Derivation Bool
ReturnControls.onePremise : Traceability.Derivation Bool
ReturnControls.nodeOnly : Unit → Traceability.Graph Bool
ReturnControls.head_without_derivation : (Traceability.fold ReturnControls.nodeOnly [()]).nodes
      ReturnControls.noPremises.head =
    true ∧
  (Traceability.fold ReturnControls.nodeOnly [()]).edges ReturnControls.noPremises = false
ReturnControls.head_only_claim_fails : ¬∀ (lift : Unit → Traceability.Graph Bool) (l : List Unit)
    (d : Traceability.Derivation Bool),
    (Traceability.fold lift l).nodes d.head = true → (Traceability.fold lift l).edges d = true
ReturnControls.edgeOnly : Unit → Traceability.Graph Bool
ReturnControls.derivation_without_head : (Traceability.fold ReturnControls.edgeOnly [()]).edges
      ReturnControls.noPremises =
    true ∧
  (Traceability.fold ReturnControls.edgeOnly [()]).nodes ReturnControls.noPremises.head = false
ReturnControls.edge_implies_head_claim_fails : ¬∀ (lift : Unit → Traceability.Graph Bool) (l : List Unit)
    (d : Traceability.Derivation Bool),
    (Traceability.fold lift l).edges d = true → (Traceability.fold lift l).nodes d.head = true
ReturnControls.exactLift : Unit → Traceability.Graph Bool
ReturnControls.witnessed_head_does_not_select_premises : (Traceability.fold ReturnControls.exactLift [()]).nodes
      ReturnControls.noPremises.head =
    true ∧
  ReturnControls.onePremise.head = ReturnControls.noPremises.head ∧
    (Traceability.fold ReturnControls.exactLift [()]).edges ReturnControls.onePremise = true ∧
      (Traceability.fold ReturnControls.exactLift [()]).edges ReturnControls.noPremises = false
ReturnControls.finiteDerivationEq : (a b : Traceability.Derivation Bool) → Decidable (a = b)
ReturnControls.record : Bool → Traceability.Derivation Bool
ReturnControls.same_head_distinct_recorded_premises : (Traceability.fold (Traceability.recordLift ReturnControls.record)
          [false, true]).nodes
      ReturnControls.noPremises.head =
    true ∧
  (Traceability.fold (Traceability.recordLift ReturnControls.record) [false, true]).edges ReturnControls.noPremises =
      true ∧
    (Traceability.fold (Traceability.recordLift ReturnControls.record) [false, true]).edges ReturnControls.onePremise =
        true ∧
      ReturnControls.noPremises.head = ReturnControls.onePremise.head ∧
        ReturnControls.noPremises ≠ ReturnControls.onePremise
ReturnControls.aliasedLift : Bool → Traceability.Graph Bool
ReturnControls.contributor_refuses_missing_edge : (Traceability.fold ReturnControls.nodeOnly [()]).nodes
      ReturnControls.noPremises.head =
    true ∧
  Traceability.contributor ReturnControls.nodeOnly [()] ReturnControls.noPremises = none
ReturnControls.contributor_selection_is_order_sensitive : Traceability.fold ReturnControls.aliasedLift [false, true] =
    Traceability.fold ReturnControls.aliasedLift [true, false] ∧
  Traceability.contributor ReturnControls.aliasedLift [false, true] ReturnControls.noPremises = some false ∧
    Traceability.contributor ReturnControls.aliasedLift [true, false] ReturnControls.noPremises = some true
ReturnControls.source_from_fold_claim_fails : ¬∃ decode,
    ∀ (e : Bool), decode (Traceability.fold ReturnControls.aliasedLift [e]) = e
ReturnControls.time_from_fold_claim_fails : ¬∃ decode,
    ∀ (time : Nat), decode (Traceability.foldtimed ReturnControls.aliasedLift [{ event := false, time := time }]) = time
Sharing.scope : Incremental.Stage → Nat → Incremental.Scope
Sharing.key : Incremental.Stage → Nat → Incremental.TaskKey
@Sharing.value : {Value : Type} → (Incremental.Scope → List Value → Value) → Incremental.Stage → Nat → Value
@Sharing.row : {Value : Type} →
  (Incremental.Scope → List Value → Value) → Incremental.Stage → Nat → Incremental.Entry Value
@Sharing.cache : {Value : Type} →
  (Incremental.Scope → List Value → Value) → Incremental.Stage → Nat → Incremental.Cache Value
Sharing.requests : Incremental.Stage → Nat → List Incremental.TaskKey
@Sharing.unfolded : {Value : Type} → (Incremental.Scope → List Value → Value) → Incremental.Stage → Nat → Value × Nat
@Sharing.cache_succ : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Sharing.cache op stage (count + 1) = Sharing.cache op stage count ++ [Sharing.row op stage count]
@Sharing.cache_length : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), List.length (Sharing.cache op stage count) = count
@Sharing.cache_row : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  {index count : Nat}, index < count → (Sharing.cache op stage count)[index]? = some (Sharing.row op stage index)
Sharing.requests_succ : ∀ (stage : Incremental.Stage) (count : Nat),
  Sharing.requests stage (count + 1) = Sharing.requests stage count ++ [Sharing.key stage count]
@Sharing.key_fresh : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Incremental.lookup (Sharing.cache op stage count) (Sharing.key stage count) = none
@Sharing.resolve_children : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat),
  Incremental.resolve (Sharing.cache op stage count) (Sharing.key stage count).premises =
    some
      (match count with
      | 0 => []
      | n.succ => [Sharing.value op stage n, Sharing.value op stage n])
@Sharing.step_succ : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat),
  Incremental.step op (Sharing.cache op stage count) (Sharing.key stage count) =
    some (Sharing.cache op stage (count + 1))
@Sharing.run_diamond : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Incremental.run op [] (Sharing.requests stage count) = some (Sharing.cache op stage count)
@Sharing.diamond_valid : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Incremental.ValidLog op (Sharing.cache op stage count)
@Sharing.work_diamond : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Incremental.work (Sharing.cache op stage count) = count
@Sharing.stageWork_diamond : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (count : Nat), Incremental.stageWork stage (Sharing.cache op stage count) = count
@Sharing.unfolded_value : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (depth : Nat), (Sharing.unfolded op stage depth).fst = Sharing.value op stage depth
@Sharing.unfolded_calls : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value) (stage : Incremental.Stage)
  (depth : Nat), (Sharing.unfolded op stage depth).snd = 2 ^ (depth + 1) - 1
@Sharing.diamond_compression : ∀ {Value : Type} (op : Incremental.Scope → List Value → Value)
  (stage : Incremental.Stage) (depth : Nat),
  Incremental.run op [] (Sharing.requests stage (depth + 1)) = some (Sharing.cache op stage (depth + 1)) ∧
    Incremental.work (Sharing.cache op stage (depth + 1)) = depth + 1 ∧
      Incremental.stageWork stage (Sharing.cache op stage (depth + 1)) = depth + 1 ∧
        (Sharing.cache op stage (depth + 1))[depth]? =
            some { key := Sharing.key stage depth, value := (Sharing.unfolded op stage depth).fst } ∧
          (Sharing.unfolded op stage depth).snd = 2 ^ (depth + 1) - 1
