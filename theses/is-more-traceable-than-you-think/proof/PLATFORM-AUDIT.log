Families.Component : Type
Families.checked : Families.Component → Bool
Families.sourceComponent : Pipeline.Environment → Families.Component → Option Int
Families.targetComponent : Pipeline.Environment → Families.Component → Option Int
Families.sourceTuple : Pipeline.Environment → List Families.Component → Option (List Int)
Families.targetTuple : Pipeline.Environment → List Families.Component → Option (List Int)
@Families.assignments : {α : Type} → List (List α) → List (List α)
@Families.assignmentCount : {α : Type} → List (List α) → Nat
@Families.storedReferences : {α : Type} → List (List α) → Nat
Families.binaryTuples : Nat → List (List Bool)
@Families.checked_component_correct : ∀ {component : Families.Component},
  Families.checked component = true →
    ∀ (env : Pipeline.Environment),
      ∃ value, Families.sourceComponent env component = some value ∧ Families.targetComponent env component = some value
@Families.independent_tuple_correct : ∀ {components : List Families.Component},
  (∀ (component : Families.Component), component ∈ components → Families.checked component = true) →
    ∀ (env : Pipeline.Environment),
      ∃ values,
        Families.sourceTuple env components = some values ∧
          Families.targetTuple env components = some values ∧ values.length = components.length
@Families.flatMap_constant_length : ∀ {α β : Type} (items : List α) (f : α → List β) (count : Nat),
  (∀ (item : α), item ∈ items → (f item).length = count) → (List.flatMap f items).length = items.length * count
@Families.assignment_count_exact : ∀ {α : Type} (factors : List (List α)),
  (Families.assignments factors).length = Families.assignmentCount factors
@Families.selected_length : ∀ {α : Type} {factors : List (List α)} {selected : List α},
  selected ∈ Families.assignments factors → selected.length = factors.length
@Families.selected_member : ∀ {α : Type} {factors : List (List α)} {selected : List α},
  selected ∈ Families.assignments factors →
    ∀ {item : α}, item ∈ selected → ∃ alternatives, alternatives ∈ factors ∧ item ∈ alternatives
@Families.every_selection_correct : ∀ {factors : List (List Families.Component)},
  (∀ (alternatives : List Families.Component),
      alternatives ∈ factors →
        ∀ (component : Families.Component), component ∈ alternatives → Families.checked component = true) →
    ∀ {selected : List Families.Component},
      selected ∈ Families.assignments factors →
        ∀ (env : Pipeline.Environment),
          ∃ values,
            Families.sourceTuple env selected = some values ∧
              Families.targetTuple env selected = some values ∧ values.length = factors.length
@Families.repeated_factor_count : ∀ {α : Type} (alternatives : List α) (count : Nat),
  Families.assignmentCount (List.replicate count alternatives) = alternatives.length ^ count
@Families.binary_assignment_count : ∀ {α : Type} (left right : α) (count : Nat),
  (Families.assignments (List.replicate count [left, right])).length = 2 ^ count
@Families.binary_stored_references : ∀ {α : Type} (left right : α) (count : Nat),
  Families.storedReferences (List.replicate count [left, right]) = 2 * count
Families.binaryTuples_assignments : ∀ (count : Nat),
  Families.binaryTuples count = Families.assignments (List.replicate count [false, true])
@Families.prefix_preserves_nodup : ∀ {α : Type} (item : α) {tuples : List (List α)},
  tuples.Nodup → (List.map (fun x => item :: x) tuples).Nodup
Families.binaryTuples_nodup : ∀ (count : Nat), (Families.binaryTuples count).Nodup
Families.binary_compact_distinct : ∀ (count : Nat),
  (Families.binaryTuples count).Nodup ∧
    (Families.binaryTuples count).length = 2 ^ count ∧
      Families.storedReferences (List.replicate count [false, true]) = 2 * count
Families.binary_component_family_correct : ∀ (left right : Families.Component),
  Families.checked left = true →
    Families.checked right = true →
      ∀ (count : Nat),
        (Families.assignments (List.replicate count [left, right])).length = 2 ^ count ∧
          Families.storedReferences (List.replicate count [left, right]) = 2 * count ∧
            ∀ (selected : List Families.Component),
              selected ∈ Families.assignments (List.replicate count [left, right]) →
                ∀ (env : Pipeline.Environment),
                  ∃ values,
                    Families.sourceTuple env selected = some values ∧
                      Families.targetTuple env selected = some values ∧ values.length = count
@HeadedReturn.Headed : {Node Ev : Type} → (Ev → Traceability.Graph Node) → Prop
@HeadedReturn.Closed : {Node Ev : Type} → (Ev → Traceability.Graph Node) → Prop
@HeadedReturn.Grounded : {Node Ev : Type} → (Ev → Traceability.Graph Node) → Prop
@HeadedReturn.returns_headed : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node),
  HeadedReturn.Headed lift →
    ∀ {l : List Ev} {n : Node},
      (Traceability.fold lift l).nodes n = true →
        ∃ d,
          (Traceability.fold lift l).edges d = true ∧
            d.head = n ∧ ∃ e, e ∈ l ∧ (lift e).nodes n = true ∧ (lift e).edges d = true
@HeadedReturn.head_witnessed : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node),
  HeadedReturn.Closed lift →
    ∀ {l : List Ev} {d : Traceability.Derivation Node},
      (Traceability.fold lift l).edges d = true → (Traceability.fold lift l).nodes d.head = true
@HeadedReturn.returns_headed_iff : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node),
  HeadedReturn.Headed lift →
    HeadedReturn.Closed lift →
      ∀ {l : List Ev} {n : Node},
        (Traceability.fold lift l).nodes n = true ↔ ∃ d, (Traceability.fold lift l).edges d = true ∧ d.head = n
@HeadedReturn.returned_premises_witnessed : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node),
  HeadedReturn.Grounded lift →
    ∀ {l : List Ev} {d : Traceability.Derivation Node} {m : Node},
      (Traceability.fold lift l).edges d = true → d.premises m = true → (Traceability.fold lift l).nodes m = true
@HeadedReturn.headed_iff_singleton : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node),
  HeadedReturn.Headed lift ↔
    ∀ (e : Ev) (n : Node),
      (Traceability.fold lift [e]).nodes n = true → ∃ d, (Traceability.fold lift [e]).edges d = true ∧ d.head = n
@HeadedReturn.unique_iff_contributed_unique : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l : List Ev},
  (∀ (d d' : Traceability.Derivation Node),
      (Traceability.fold lift l).edges d = true →
        (Traceability.fold lift l).edges d' = true → d.head = d'.head → d = d') ↔
    ∀ (e e' : Ev) (d d' : Traceability.Derivation Node),
      e ∈ l → e' ∈ l → (lift e).edges d = true → (lift e').edges d' = true → d.head = d'.head → d = d'
@HeadedReturn.recordLift_headed : ∀ {Node Ev : Type} [inst : DecidableEq Node]
  [inst_1 : DecidableEq (Traceability.Derivation Node)] (record : Ev → Traceability.Derivation Node),
  HeadedReturn.Headed (Traceability.recordLift record)
@HeadedReturn.recordLift_closed : ∀ {Node Ev : Type} [inst : DecidableEq Node]
  [inst_1 : DecidableEq (Traceability.Derivation Node)] (record : Ev → Traceability.Derivation Node),
  HeadedReturn.Closed (Traceability.recordLift record)
