Evaluation.Tree : Type
Evaluation.source : Evaluation.Tree → Int
Evaluation.zero : Pipeline.Environment
Evaluation.capturedEnvironment : String → Int → Pipeline.Environment
Evaluation.target : Evaluation.Tree → Option Int
Evaluation.Correct : Evaluation.Tree → Int → Prop
@Evaluation.literal_correct : ∀ {value result : Int} {code : List Pipeline.Instruction},
  code = Pipeline.compile (Pipeline.Operation.literal value) →
    value = result → Evaluation.Correct (Evaluation.Tree.literal value code) result
@Evaluation.input_correct : ∀ {name : String} {captured result : Int} {code : List Pipeline.Instruction},
  code = Pipeline.compile (Pipeline.Operation.input name) →
    captured = result → Evaluation.Correct (Evaluation.Tree.input name captured code) result
@Evaluation.add_correct : ∀ {left right : Evaluation.Tree} {a b result : Int} {code : List Pipeline.Instruction},
  Evaluation.Correct left a →
    Evaluation.Correct right b →
      code = Pipeline.compile Pipeline.Operation.add → a + b = result → Evaluation.Correct (left.add right code) result
@Evaluation.mul_correct : ∀ {left right : Evaluation.Tree} {a b result : Int} {code : List Pipeline.Instruction},
  Evaluation.Correct left a →
    Evaluation.Correct right b →
      code = Pipeline.compile Pipeline.Operation.mul → a * b = result → Evaluation.Correct (left.mul right code) result
@Evaluation.neg_correct : ∀ {child : Evaluation.Tree} {value result : Int} {code : List Pipeline.Instruction},
  Evaluation.Correct child value →
    code = Pipeline.compile Pipeline.Operation.neg → -value = result → Evaluation.Correct (child.neg code) result
@Evaluation.correct_unique_value : ∀ {tree : Evaluation.Tree} {first second : Int},
  Evaluation.Correct tree first → Evaluation.Correct tree second → first = second
Evaluation.Agrees : Pipeline.Environment → Evaluation.Tree → Prop
Evaluation.globalSource : Pipeline.Environment → Evaluation.Tree → Int
Evaluation.agrees_source : ∀ (env : Pipeline.Environment) (tree : Evaluation.Tree),
  Evaluation.Agrees env tree → Evaluation.globalSource env tree = Evaluation.source tree
@Evaluation.agrees_correct : ∀ {env : Pipeline.Environment} {tree : Evaluation.Tree} {result : Int},
  Evaluation.Agrees env tree →
    Evaluation.Correct tree result → Evaluation.globalSource env tree = result ∧ Evaluation.target tree = some result
