Provenance.witnesses : (tasks : List Incremental.TaskKey) → List Nat → List (Provenance.Event tasks)
Provenance.occurrence_decode : ∀ (tasks : List Incremental.TaskKey) (event : Provenance.Event tasks)
  (position : Fin tasks[↑event].premises.length),
  Provenance.decode tasks (Provenance.occurrence tasks event position) = some tasks[↑event].premises[↑position]
Provenance.decode_ordered : ∀ (tasks : List Incremental.TaskKey) (event : Provenance.Event tasks),
  List.map (Provenance.decode tasks) (List.ofFn (Provenance.occurrence tasks event)) =
    List.map some tasks[↑event].premises
Provenance.occurrence_position_injective : ∀ (tasks : List Incremental.TaskKey) (event : Provenance.Event tasks)
  {left right : Fin tasks[↑event].premises.length},
  Provenance.occurrence tasks event left = Provenance.occurrence tasks event right → left = right
