Traceability.Derivation : Type → Type
Traceability.Graph : Type → Type
@Traceability.join : {Node : Type} → Traceability.Graph Node → Traceability.Graph Node → Traceability.Graph Node
@Traceability.empty : {Node : Type} → Traceability.Graph Node
@Traceability.fold : {Node Ev : Type} → (Ev → Traceability.Graph Node) → List Ev → Traceability.Graph Node
Traceability.Timed : Type → Type → Type
@Traceability.foldtimed : {Node Ev Time : Type} →
  (Ev → Traceability.Graph Node) → List (Traceability.Timed Ev Time) → Traceability.Graph Node
@Traceability.bool_eq_of_agree : ∀ {a b : Bool}, (a = true ↔ b = true) → a = b
@Traceability.graph_ext : ∀ {Node : Type} {g h : Traceability.Graph Node},
  (∀ (n : Node), g.nodes n = h.nodes n) → (∀ (d : Traceability.Derivation Node), g.edges d = h.edges d) → g = h
@Traceability.join_assoc : ∀ {Node : Type} (a b c : Traceability.Graph Node),
  Traceability.join (Traceability.join a b) c = Traceability.join a (Traceability.join b c)
@Traceability.join_comm : ∀ {Node : Type} (a b : Traceability.Graph Node), Traceability.join a b = Traceability.join b a
@Traceability.join_idem : ∀ {Node : Type} (a : Traceability.Graph Node), Traceability.join a a = a
@Traceability.join_empty_left : ∀ {Node : Type} (a : Traceability.Graph Node),
  Traceability.join Traceability.empty a = a
@Traceability.join_empty_right : ∀ {Node : Type} (a : Traceability.Graph Node),
  Traceability.join a Traceability.empty = a
@Traceability.fold_append : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) (l₁ l₂ : List Ev),
  Traceability.fold lift (l₁ ++ l₂) = Traceability.join (Traceability.fold lift l₁) (Traceability.fold lift l₂)
@Traceability.fold_nodes : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l : List Ev} {n : Node},
  (Traceability.fold lift l).nodes n = true ↔ ∃ e, e ∈ l ∧ (lift e).nodes n = true
@Traceability.fold_edges : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l : List Ev}
  {d : Traceability.Derivation Node}, (Traceability.fold lift l).edges d = true ↔ ∃ e, e ∈ l ∧ (lift e).edges d = true
@Traceability.returns_head : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l : List Ev}
  {d : Traceability.Derivation Node},
  (Traceability.fold lift l).nodes d.head = true →
    (∃ e, e ∈ l ∧ (lift e).edges d = true) → (Traceability.fold lift l).edges d = true
@Traceability.fold_ext : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l₁ l₂ : List Ev},
  (∀ (e : Ev), e ∈ l₁ ↔ e ∈ l₂) → Traceability.fold lift l₁ = Traceability.fold lift l₂
@Traceability.fold_perm : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) {l₁ l₂ : List Ev},
  l₁.Perm l₂ → Traceability.fold lift l₁ = Traceability.fold lift l₂
@Traceability.fold_append_self : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) (l : List Ev),
  Traceability.fold lift (l ++ l) = Traceability.fold lift l
@Traceability.foldtimed_ext : ∀ {Node Ev Time : Type} (lift : Ev → Traceability.Graph Node)
  {l₁ l₂ : List (Traceability.Timed Ev Time)},
  (∀ (e : Ev), e ∈ List.map Traceability.Timed.event l₁ ↔ e ∈ List.map Traceability.Timed.event l₂) →
    Traceability.foldtimed lift l₁ = Traceability.foldtimed lift l₂
@Traceability.map_event : ∀ {Ev Time : Type} (es : List Ev) (t : Ev → Time),
  List.map Traceability.Timed.event (List.map (fun e => { event := e, time := t e }) es) = es
@Traceability.foldtimed_retime : ∀ {Node Ev Time : Type} (lift : Ev → Traceability.Graph Node) (es : List Ev)
  (f g : Ev → Time),
  Traceability.foldtimed lift (List.map (fun e => { event := e, time := f e }) es) =
    Traceability.foldtimed lift (List.map (fun e => { event := e, time := g e }) es)
@Traceability.retract_nodes : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) (keep : Ev → Bool) {l : List Ev}
  {n : Node},
  (Traceability.fold lift (List.filter keep l)).nodes n = true ↔ ∃ e, e ∈ l ∧ keep e = true ∧ (lift e).nodes n = true
@Traceability.retract_edges : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) (keep : Ev → Bool) {l : List Ev}
  {d : Traceability.Derivation Node},
  (Traceability.fold lift (List.filter keep l)).edges d = true ↔ ∃ e, e ∈ l ∧ keep e = true ∧ (lift e).edges d = true
@Traceability.retract_eq : ∀ {Node Ev : Type} (lift : Ev → Traceability.Graph Node) (keep : Ev → Bool) {l s : List Ev},
  (∀ (e : Ev), e ∈ s ↔ e ∈ l ∧ keep e = true) → Traceability.fold lift (List.filter keep l) = Traceability.fold lift s
