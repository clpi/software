Controls.fullprem : Traceability.Derivation Nat
Controls.noprem : Traceability.Derivation Nat
Controls.prem_differ : Controls.fullprem ≠ Controls.noprem
Controls.grainlift : Nat → Traceability.Graph Nat
Controls.grain_absent : (Traceability.fold Controls.grainlift [0]).edges Controls.noprem = false
Controls.grain_coarse_present : ∃ d',
