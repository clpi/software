@@ -80,3 +80,22 @@ lemma New.gammaFactor_eq_zero_or_LFunction_one_sub_eq_zero (s : ℂ) (h_re : s.r
     rw [LFunction_eq_completed_div_gammaFactor ψ⁻¹ (1 - s) (.inl (sub_ne_zero.2 h_ne_one.symm)),
       hΛ_inv, zero_div]
   rw [← map_inv, LFunction_changeLevel hM ψ⁻¹ (.inr (by simpa using hs_ne_zero)), hL_inv, zero_mul]
+
+/-- The harmonic number `H_n` is at most `1 + log n`: each term `1 / (k + 1)` with `k ≥ 1` is at most
+`log (k + 1) - log k`, as `log x ≤ x - 1` at `x = k / (k + 1)`. -/
+lemma New.harmonic_le_one_add_log' (n : ℕ) : (harmonic n : ℝ) ≤ 1 + Real.log n := by
+  induction n with
+  | zero => simp
+  | succ n ih =>
+    rcases Nat.eq_zero_or_pos n with rfl | hn
+    · simp
+    have hn' : (0 : ℝ) < n := mod_cast hn
+    have h_log : ((n + 1 : ℕ) : ℝ)⁻¹ ≤ Real.log (n + 1 : ℕ) - Real.log n := by
+      have h := Real.log_le_sub_one_of_pos (x := (n : ℝ) / (n + 1)) (by positivity)
+      rw [Real.log_div hn'.ne' (by positivity)] at h
+      push_cast
+      have : (n : ℝ) / (n + 1) - 1 = -(n + 1 : ℝ)⁻¹ := by field_simp; ring
+      linarith
+    rw [harmonic_succ]
+    push_cast at ih h_log ⊢
+    linarith
