+/-- Every square matrix over a field has a pseudo-inverse: there is `g` with `a * g * a = a`.
+Take a right inverse of the corestriction of `a` to its range, after a left inverse of the
+inclusion of the range. -/
+lemma _root_.New.exists_mul_mul_eq_self_matrix {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
+    (a : Matrix ι ι K) : ∃ g : Matrix ι ι K, a * g * a = a := by
+  set f := Matrix.toLin' a
+  obtain ⟨h, hh⟩ := f.rangeRestrict.exists_rightInverse_of_surjective f.range_rangeRestrict
+  obtain ⟨π, hπ⟩ := f.range.subtype.exists_leftInverse_of_injective f.range.ker_subtype
+  refine ⟨LinearMap.toMatrix' (h ∘ₗ π), Matrix.toLin'.injective ?_⟩
+  rw [Matrix.toLin'_mul, Matrix.toLin'_mul, Matrix.toLin'_toMatrix']
+  refine LinearMap.ext fun x ↦ ?_
+  have h1 : π (f x) = f.rangeRestrict x := by
+    simpa using LinearMap.congr_fun hπ (f.rangeRestrict x)
+  have h2 : f (h (f.rangeRestrict x)) = f x := by
+    simpa using congrArg Subtype.val (LinearMap.congr_fun hh (f.rangeRestrict x))
+  change f (h (π (f x))) = f x
+  rw [h1, h2]
+
