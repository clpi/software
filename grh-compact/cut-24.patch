+
+/-- Cauchy–Schwarz for a finite sum of reals: `(∑ f)² ≤ #s * ∑ f²`. This is
+`Finset.sum_mul_sq_le_sq_mul_sq` with the constant function `1`. -/
+lemma New.sq_sum_le_card_mul_sum_sq_real {ι : Type*} {s : Finset ι} {f : ι → ℝ} :
+    (∑ i ∈ s, f i) ^ 2 ≤ s.card * ∑ i ∈ s, f i ^ 2 := by
+  simpa using Finset.sum_mul_sq_le_sq_mul_sq s (fun _ ↦ (1 : ℝ)) f
